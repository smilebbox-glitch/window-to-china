# Okno v Kitai - corporate HTTPS + SSO profile.
# Copy to .env.corporate. Local operational secrets are generated by
# START_CORPORATE_HTTPS.bat. OIDC values and TLS files must come from IT.

APP_VERSION=1.7.9-pilot

# Corporate URL / ingress.
CORPORATE_HOST=china.mgc.internal
CORPORATE_BIND_ADDRESS=0.0.0.0
CORPORATE_HTTP_PORT=80
CORPORATE_HTTPS_PORT=443
TLS_CERT_FILE=./deploy/tls/tls.crt
TLS_KEY_FILE=./deploy/tls/tls.key

# Corporate OIDC. IT must replace all CHANGE_ME_IT values.
OIDC_ISSUER_URL=CHANGE_ME_IT
OIDC_CLIENT_ID=CHANGE_ME_IT
OIDC_CLIENT_SECRET=CHANGE_ME_IT
OIDC_SCOPE=openid profile email groups
OIDC_GROUPS_CLAIM=groups

# Access is fail-closed to this IdP group even when an account exists in the
# corporate directory. IT should map this to the approved application group.
SSO_ALLOWED_GROUP=okno-china-users

# Generated automatically on first corporate start. Do not commit .env.corporate.
OAUTH2_PROXY_COOKIE_SECRET=GENERATE_ON_FIRST_START
AUTH_PROXY_SECRET=GENERATE_ON_FIRST_START
AUDIT_HMAC_KEY=GENERATE_ON_FIRST_START
SCHEDULER_TOKEN=GENERATE_ON_FIRST_START
USER_DATA_HMAC_KEY=GENERATE_ON_FIRST_START
METRICS_TOKEN=GENERATE_ON_FIRST_START

# RBAC groups must match the groups claim returned by the corporate IdP.
AUTH_ADMIN_GROUP=okno-china-admin
AUTH_EDITOR_GROUP=okno-china-editor
EXECUTIVE_MIN_ROLE=viewer
PILOT_CONTROL_MIN_ROLE=admin

# Corporate SSO session.
SSO_COOKIE_EXPIRE=8h
SSO_COOKIE_REFRESH=15m

# Optional local RAG.
RAG_API_URL=
RAG_API_KEY=
RAG_MODEL=

# Outbound policy.
OUTBOUND_ALLOWLIST=
OUTBOUND_ALLOW_HTTP_HOSTS=host.docker.internal

# Pilot and runtime defaults.
PILOT_WINDOW_DAYS=10
PILOT_TARGET_MIN_USERS=5
PILOT_TARGET_MAX_USERS=10
PILOT_MIN_FEEDBACK=3
PILOT_MIN_USEFUL_PCT=70
PILOT_MIN_REPEAT_PCT=40
AUDIT_MAX_BYTES=10485760
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_ADMIN_MUTATION_PER_5_MIN=30
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MEMORY_LIMIT=128m
SCHEDULER_CPU_LIMIT=0.25
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.5
FX_CACHE_TTL_SECONDS=900
FX_CACHE_STALE_SECONDS=86400
NEWS_CACHE_TTL_SECONDS=900
NEWS_CACHE_STALE_SECONDS=21600
NEWS_SOURCE_CONCURRENCY=4
NEWS_FETCH_TIMEOUT_MS=8000
NEWS_TRANSLATE_TIMEOUT_MS=6500
NEWS_SOURCE_DEADLINE_MS=12000
NEWS_REQUEST_DEADLINE_MS=26000
NEWS_DEDUPE_WINDOW_HOURS=72
NEWS_MAX_AGE_DAYS=45
NEWS_AGGREGATE_LIVE_QUALITY_MIN=75
PILOT_SOURCE_DEGRADED_PCT=25
TRANSLATE_MIN_INTERVAL_MS=180
TRANSLATE_MAX_ATTEMPTS=2
SOURCE_HISTORY_RETENTION_DAYS=30
SOURCE_HISTORY_MAX_ROWS=5000
EXPIRED_SNAPSHOT_RETENTION_DAYS=7
ARCHIVED_CONTENT_RETENTION_DAYS=365
SCHEDULER_LOCK_TTL_SECONDS=120
SOURCE_SLA_FX_SECONDS=1800
SOURCE_SLA_FX_MIN_QUALITY=60
SOURCE_SLA_NEWS_SECONDS=3600
SOURCE_SLA_NEWS_MIN_QUALITY=50
USAGE_RETENTION_DAYS=90

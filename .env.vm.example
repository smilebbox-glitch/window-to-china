# Test VM profile: CPU-only, no external/local generative AI.
# Copy to .env.vm. The VM launchers generate local secrets automatically.
APP_BIND_ADDRESS=0.0.0.0
ALLOW_PUBLIC_BIND=YES
APP_PORT=3000
APP_VERSION=1.7.9-pilot
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.25
SCHEDULER_MEMORY_LIMIT=96m
SCHEDULER_CPU_LIMIT=0.15

# Explicitly disable optional generative RAG/LLM layer.
# The built-in evidence-based analysis remains available.
RAG_API_URL=
RAG_API_KEY=
RAG_MODEL=

# Test VM authentication. Replace with corporate proxy/SSO for controlled production.
AUTH_MODE=disabled
AUTH_PROXY_SECRET=
AUTH_ADMIN_GROUP=okno-china-admin
AUTH_EDITOR_GROUP=okno-china-editor
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_TOKEN
EXECUTIVE_MIN_ROLE=viewer
PILOT_CONTROL_MIN_ROLE=viewer

# Local runtime secrets generated by the launcher on first start.
SCHEDULER_TOKEN=CHANGE_ME_SCHEDULER_TOKEN
USER_DATA_HMAC_KEY=CHANGE_ME_USER_HMAC
AUDIT_HMAC_KEY=CHANGE_ME_AUDIT_HMAC

# Lightweight VM runtime settings.
SCHEDULER_INTERVAL_SECONDS=300
NEWS_SOURCE_CONCURRENCY=2
NEWS_FETCH_TIMEOUT_MS=8000
NEWS_TRANSLATE_TIMEOUT_MS=6500
NEWS_SOURCE_DEADLINE_MS=12000
NEWS_REQUEST_DEADLINE_MS=26000
NEWS_CACHE_TTL_SECONDS=900
NEWS_CACHE_STALE_SECONDS=21600
FX_CACHE_TTL_SECONDS=900
FX_CACHE_STALE_SECONDS=86400
SOURCE_HISTORY_RETENTION_DAYS=30
SOURCE_HISTORY_MAX_ROWS=5000
SCHEDULER_LOCK_TTL_SECONDS=120
SOURCE_SLA_FX_SECONDS=1800
SOURCE_SLA_NEWS_SECONDS=3600
USAGE_RETENTION_DAYS=90
OUTBOUND_ALLOW_HTTP_HOSTS=host.docker.internal

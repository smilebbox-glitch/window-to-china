map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream okno_app {
    server china-auto-radar:3000;
    keepalive 32;
}

upstream okno_oauth2 {
    server oauth2-proxy:4180;
    keepalive 16;
}

server {
    listen 8080;
    server_name ${CORPORATE_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${CORPORATE_HOST};

    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 4m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        proxy_pass http://okno_app/api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
    }

    location = /readyz {
        proxy_pass http://okno_app/api/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
    }

    # Monitoring remains inside the server/container network. Do not expose
    # application metrics through the user-facing corporate ingress.
    location = /api/metrics {
        return 404;
    }

    location = /_oauth2_auth {
        internal;
        proxy_pass http://okno_oauth2/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
    }

    location /oauth2/ {
        proxy_pass http://okno_oauth2;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect https://$host$request_uri;
    }

    location @oauth2_signin {
        return 302 /oauth2/start?rd=https://$host$request_uri;
    }

    location / {
        auth_request /_oauth2_auth;
        error_page 401 = @oauth2_signin;

        auth_request_set $sso_user   $upstream_http_x_auth_request_user;
        auth_request_set $sso_email  $upstream_http_x_auth_request_email;
        auth_request_set $sso_groups $upstream_http_x_auth_request_groups;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $request_id;

        # These identity headers are created only from the trusted auth_request
        # response. Client-provided X-Forwarded-* identity headers are overwritten.
        proxy_set_header X-Forwarded-User $sso_user;
        proxy_set_header X-Forwarded-Email $sso_email;
        proxy_set_header X-Forwarded-Groups $sso_groups;
        proxy_set_header X-Okno-Proxy-Secret "${AUTH_PROXY_SECRET}";

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_pass http://okno_app;
    }
}

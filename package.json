{
  "name": "okno-v-kitai",
  "version": "1.7.9-pilot",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:latest": "node --test tests/current-pilot-regressions.test.mjs tests/news-received-time-v179.test.mjs tests/web-notifications.test.mjs tests/pilot-ui-functionality-v180.test.mjs",
    "test:runtime": "node --test tests/runtime-smoke.mjs",
    "test:pilot:contracts": "node --test tests/pilot-functionality-v177.test.mjs",
    "test:pilot:runtime": "node --test tests/pilot-runtime-v177.mjs",
    "test:pilot:ui": "node --test tests/pilot-ui-functionality-v180.test.mjs tests/current-pilot-regressions.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "pilot:security": "node scripts/pilot-security-preflight.mjs",
    "pilot:operations": "node scripts/pilot-operations-preflight.mjs",
    "pilot:sbom": "node scripts/generate-sbom.mjs",
    "pilot:preflight": "npm run pilot:security && npm run pilot:operations && npm run pilot:reliability && npm run pilot:governance && npm run pilot:business && npm run pilot:oneclick && npm run pilot:intelligence && npm run pilot:decision && npm run pilot:executive && npm run pilot:ops174 && npm run pilot:controlled && npm run pilot:ui176 && npm run pilot:ui-functional && npm run pilot:functional && npm run pilot:pwa && npm run pilot:corporate && npm run test:latest && npm run pilot:syntax && npm run pilot:sbom",
    "pilot:preflight:online": "npm run pilot:preflight && npm run pilot:audit-deps",
    "pilot:audit-deps": "npm audit --audit-level=high --omit=dev",
    "pilot:host": "bash scripts/host-preflight.sh",
    "pilot:smoke": "bash scripts/container-smoke.sh",
    "pilot:syntax": "tsc --noEmit --noCheck",
    "pilot:reliability": "node scripts/pilot-reliability-preflight.mjs",
    "pilot:data-backup": "node scripts/sqlite-backup.mjs",
    "pilot:governance": "node scripts/pilot-governance-preflight.mjs",
    "pilot:acceptance": "node scripts/generate-acceptance-report.mjs",
    "pilot:business": "node scripts/pilot-business-preflight.mjs",
    "pilot:oneclick": "node scripts/pilot-oneclick-preflight.mjs",
    "pilot:intelligence": "node scripts/news-intelligence-preflight.mjs",
    "pilot:decision": "node scripts/decision-cockpit-preflight.mjs",
    "pilot:executive": "node scripts/executive-brief-preflight.mjs",
    "pilot:ops174": "node scripts/pilot-operations-v174-preflight.mjs",
    "pilot:go-no-go": "node scripts/pilot-go-no-go.mjs",
    "pilot:controlled": "node scripts/controlled-pilot-preflight.mjs",
    "pilot:outcome": "node scripts/pilot-outcome.mjs",
    "pilot:ui176": "node scripts/corporate-ui-v176-preflight.mjs",
    "pilot:ui-functional": "node --test tests/pilot-ui-functionality-v180.test.mjs",
    "pilot:pwa": "node scripts/pwa-webapp-preflight.mjs",
    "pilot:corporate": "node scripts/corporate-https-sso-preflight.mjs",
    "pilot:functional": "node --test tests/pilot-functionality-v177.test.mjs",
    "pilot:functional:runtime": "node --test tests/pilot-runtime-v177.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

# Доступ из локальной сети включён по умолчанию: сервис слушает все интерфейсы хоста.
# Для режима только на одном ПК установите APP_BIND_ADDRESS=127.0.0.1 и ALLOW_PUBLIC_BIND=NO.
APP_BIND_ADDRESS=0.0.0.0
# Разрешает bind на все интерфейсы. Используйте только в доверенной LAN/корпоративной сети и с firewall.
ALLOW_PUBLIC_BIND=YES
APP_PORT=3000
APP_VERSION=1.6.1-pilot
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.5

# Генеративный слой необязателен. Без него работает встроенный доказательный анализ.
RAG_API_URL=
RAG_API_KEY=
RAG_MODEL=
# Пример локального Ollama:
# RAG_API_URL=http://host.docker.internal:11434/v1/chat/completions
# RAG_API_KEY=ollama
# RAG_MODEL=qwen2.5:7b

# Аутентификация.
# disabled: обычный пилот без SSO; admin-операции доступны только по ADMIN_API_TOKEN.
# proxy: identity принимается только от доверенного reverse proxy с AUTH_PROXY_SECRET.
AUTH_MODE=disabled
AUTH_PROXY_SECRET=
AUTH_ADMIN_GROUP=okno-china-admin
AUTH_EDITOR_GROUP=okno-china-editor
ADMIN_API_TOKEN=

# /api/metrics. Если пусто — endpoint доступен внутри сетевого контура без токена.
METRICS_TOKEN=

# Дополнительные исходящие hostname через запятую. Встроенные домены приложения уже allow-listed.
OUTBOUND_ALLOWLIST=
# HTTP разрешён только для явно перечисленных внутренних hostnames; HTTPS — основной режим.
OUTBOUND_ALLOW_HTTP_HOSTS=host.docker.internal

# Operations / audit. Для корпоративного пилота задайте случайный AUDIT_HMAC_KEY
# через secret store, а не в Git/.env, если .env хранится как обычный файл.
AUDIT_HMAC_KEY=
AUDIT_MAX_BYTES=10485760

# Rate limiting: локальный fixed-window limiter для single-instance пилота.
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_ADMIN_MUTATION_PER_5_MIN=30

# Reliability / persistent cache / scheduler.
# Для корпоративного пилота задайте длинный случайный SCHEDULER_TOKEN через secret store.
SCHEDULER_TOKEN=change-me-before-pilot
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MEMORY_LIMIT=128m
SCHEDULER_CPU_LIMIT=0.25
FX_CACHE_TTL_SECONDS=900
FX_CACHE_STALE_SECONDS=86400
NEWS_CACHE_TTL_SECONDS=900
NEWS_CACHE_STALE_SECONDS=21600

# v1.7 China Intelligence ingestion. Ограничения защищают сервер от всплесков при недоступных внешних сайтах.
NEWS_SOURCE_CONCURRENCY=5
NEWS_FETCH_TIMEOUT_MS=5000
NEWS_TRANSLATE_TIMEOUT_MS=3200
NEWS_SOURCE_DEADLINE_MS=7500
NEWS_REQUEST_DEADLINE_MS=14000
NEWS_DEDUPE_WINDOW_HOURS=72
NEWS_MAX_AGE_DAYS=45

# Governance / retention / SLA. Эти параметры принадлежат IT policy и обычно не меняются через UI.
SOURCE_HISTORY_RETENTION_DAYS=30
SOURCE_HISTORY_MAX_ROWS=5000
EXPIRED_SNAPSHOT_RETENTION_DAYS=7
ARCHIVED_CONTENT_RETENTION_DAYS=365
SCHEDULER_LOCK_TTL_SECONDS=120
SOURCE_SLA_FX_SECONDS=1800
SOURCE_SLA_FX_MIN_QUALITY=60
SOURCE_SLA_NEWS_SECONDS=3600
SOURCE_SLA_NEWS_MIN_QUALITY=50

# v1.6 Business Operations / privacy. Обязательно замените для controlled pilot.
USER_DATA_HMAC_KEY=change-me-user-data-hmac-before-pilot
USAGE_RETENTION_DAYS=90

* text=auto

# Runtime and build files must keep Unix line endings for Docker/Linux.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Native Windows launchers, if added later, use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

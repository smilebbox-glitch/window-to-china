# Host firewall boundary for the temporary dual-service VM.
# Copy to .env.vm-host and replace the placeholder with ONE approved corporate IPv4 CIDR.
# The launchers refuse a real VM start until this value is configured and the host firewall passes preflight.
MGC_VM_ALLOWED_CIDR=CHANGE_ME_CORPORATE_CIDR

# Fixed temporary pilot ingress contract:
# - Okno v Kitai: TCP 3000
# - MGC Languages nginx: TCP 8080
# Do not add database, scheduler, application-internal or public Internet ranges here.
